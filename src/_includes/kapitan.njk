---
layout: zaklad.njk
---
{# Kapitánská sekce: jméno týmu a odhlášení, ukazatel kroků, obsah stránky a dole tlačítka Zpět / Dál.
   Na stránce je jen jedna věc, dál se jde tlačítkem „Dál“ (Keksa 4. 10. 2026). Stránky se neindexují. #}
<link rel="stylesheet" href="{{ web.zaklad }}/assets/kapitan.css">
<div class="k-lista" id="k-lista" hidden>
  <span class="k-tym" id="k-tym"></span>
  <button type="button" class="k-odkaz" id="k-odhlasit">Odhlásit</button>
</div>
<nav aria-label="Kroky kapitánské sekce"><ol class="k-kroky" id="k-kroky" hidden></ol></nav>
<h1>{{ titulek }}</h1>
<div id="k-obsah"><p class="prazdno">Načítám…</p></div>
<nav class="k-navigace" id="k-navigace" aria-label="Další a předchozí krok" hidden></nav>
<script>
  window.HB = { url: "{{ web.supabaseUrl }}", klic: "{{ web.supabaseKlic }}", zaklad: "{{ web.zaklad }}",
                krok: "{{ krok }}", vlastniNavigace: {{ "true" if vlastniNavigace else "false" }} };
</script>
<script src="{{ web.zaklad }}/assets/kapitan.js"></script>
{% if skript %}<script src="{{ web.zaklad }}/assets/{{ skript }}"></script>{% endif %}
