---
layout: zaklad.njk
---
{# Kapitánská sekce: lišta s týmem a odkazy, obsah plní skript stránky. Stránky se neindexují. #}
<link rel="stylesheet" href="{{ web.zaklad }}/assets/kapitan.css">
<nav class="k-lista" id="k-lista" aria-label="Kapitánská sekce" hidden>
  <span class="k-tym" id="k-tym"></span>
  <a href="{{ web.zaklad }}/kapitan/"{% if sekce == "prehled" %} aria-current="page"{% endif %}>Přehled</a>
  <a href="{{ web.zaklad }}/kapitan/soupiska/"{% if sekce == "soupiska" %} aria-current="page"{% endif %}>Soupiska</a>
  <a href="{{ web.zaklad }}/kapitan/etapy/"{% if sekce == "etapy" %} aria-current="page"{% endif %}>Etapy</a>
  <button type="button" class="k-odkaz" id="k-odhlasit">Odhlásit</button>
</nav>
<h1>{{ titulek }}</h1>
<div id="k-obsah"><p class="prazdno">Načítám…</p></div>
<script>
  window.HB = { url: "{{ web.supabaseUrl }}", klic: "{{ web.supabaseKlic }}", zaklad: "{{ web.zaklad }}" };
</script>
<script src="{{ web.zaklad }}/assets/kapitan.js"></script>
{% if skript %}<script src="{{ web.zaklad }}/assets/{{ skript }}"></script>{% endif %}
