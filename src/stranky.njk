---
pagination:
  data: obsah.stranky
  size: 1
  alias: stranka
permalink: "{{ stranka.adresa }}index.html"
layout: zaklad.njk
eleventyComputed:
  titulek: "{{ stranka.titulek }}"
  metaPopis: "{{ stranka.metaPopis }}"
  stav: "{{ stranka.stav }}"
  upozorneni: "{{ stranka.upozorneni }}"
  adresa: "{{ stranka.adresa }}"
---
<h1>{{ stranka.titulek }}</h1>

{% if stranka.kod == "uvod" %}
  <p class="perex">{{ web.popis }}</p>
{% endif %}

{% if stranka.text %}
  <div class="text">{{ stranka.text | safe }}</div>
{% endif %}

{% for blok in stranka.bloky %}
  <section class="blok">
    {% if blok.titulek %}<h2>{{ blok.titulek }}</h2>{% endif %}
    {% if blok.obsah %}<div class="text">{{ blok.obsah | safe }}</div>{% endif %}
  </section>
{% endfor %}

{% if stranka.kod == "trasa" and trasa.etapy.length %}
  <p class="trasa-souhrn">
    {{ trasa.celkem.etap }} etap, {{ trasa.celkem.km }} km, celkem {{ trasa.celkem.prevyseni }} m stoupání.
    Každá etapa má vlastní stránku s profilem, mapou a popisem trasy.
  </p>
  <div class="table-responsive">
  <table class="trasa-tabulka">
    <thead>
      <tr><th>Č.</th><th>Etapa</th><th>Délka</th><th>Stoupání</th><th>Klesání</th><th>Povrch</th><th>Karta</th></tr>
    </thead>
    <tbody>
      {% for e in trasa.etapy %}
      <tr>
        <td class="trasa-cislo">{{ e.cislo }}</td>
        <td><a href="{{ web.zaklad }}{{ e.adresa }}">{{ e.nazev }}</a></td>
        <td>{{ e.delkaKm }} km</td>
        <td>{{ e.prevyseni }} m</td>
        <td>{{ e.klesani }} m</td>
        <td class="trasa-povrch">{{ e.povrch }}</td>
        <td>{% if e.pdf %}<a href="{{ web.zaklad }}{{ e.pdf }}">PDF</a>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
{% endif %}

{% if stranka.kod == "casto-se-ptate" %}
  <div class="faq">
  {% for o in obsah.otazky %}
    <details class="otazka">
      <summary>{{ o.otazka | striptags | trim }}</summary>
      <div class="text">{{ o.odpoved | safe }}</div>
    </details>
  {% endfor %}
  </div>
  <p class="pocet">Otázek celkem: {{ obsah.otazky.length }}.</p>
{% endif %}

{% if stranka.kod == "vysledky" %}
  <div id="vysledky-online" class="vysledky-online"></div>
  <script>window.HB = { url: "{{ web.supabaseUrl }}", klic: "{{ web.supabaseKlic }}", zaklad: "{{ web.zaklad }}" };</script>
  <script src="{{ web.zaklad }}/assets/vysledky-model.js" defer></script>
  <script src="{{ web.zaklad }}/assets/vysledky.js" defer></script>
  {% if obsah.archiv and obsah.archiv.length %}
  <section class="vitezove">
    <h2>Vítězové ročníků</h2>
    <div class="vit-mrizka">
    {% for r in obsah.archiv %}
      <article class="vit">
        {% if r.fotoCelkem %}<img src="{{ r.fotoCelkem }}" alt="Vítězný tým Hory Bory {{ r.letopocet }} – {{ r.vitez.tym }}" loading="lazy" width="768" height="512">{% endif %}
        <div class="vit-text">
          <p class="vit-rok">Hory Bory {{ r.letopocet }}</p>
          <p class="vit-jmeno">{{ r.vitez.tym }}</p>
          <p class="vit-cas">{{ r.vitez.cas }}</p>
          <ol start="2">{% for d in r.dalsi %}<li>{{ d.tym }} <span class="vit-cas">{{ d.cas }}</span></li>{% endfor %}</ol>
          {% if r.zeny %}
          <div class="vit-zeny">
            {% if r.fotoZeny %}<img src="{{ r.fotoZeny }}" alt="Vítězky ženské kategorie Hory Bory {{ r.letopocet }} – {{ r.zeny.tym }}" loading="lazy" width="768" height="512">{% endif %}
            Ženy: <strong>{{ r.zeny.tym }}</strong> <span class="vit-cas">{{ r.zeny.cas }}</span>
          </div>
          {% endif %}
          <a href="{{ web.zaklad }}{{ r.adresa }}">Celé výsledky {{ r.letopocet }}</a>
        </div>
      </article>
    {% endfor %}
    </div>
  </section>
  {% endif %}
{% endif %}

{% if stranka.kod == "seznamka" %}
  <link rel="stylesheet" href="{{ web.zaklad }}/assets/seznamka.css">
  <div id="seznamka" class="seznamka"><p class="prazdno">Načítám inzeráty…</p></div>
  <script>window.HB = { url: "{{ web.supabaseUrl }}", klic: "{{ web.supabaseKlic }}", zaklad: "{{ web.zaklad }}" };</script>
  <script src="{{ web.zaklad }}/assets/seznamka.js" defer></script>
{% endif %}

{% if not stranka.text and stranka.bloky.length == 0 and stranka.kod != "casto-se-ptate" and stranka.kod != "vysledky" and stranka.kod != "seznamka" %}
  <p class="prazdno">Obsah téhle stránky se teprve připravuje.</p>
{% endif %}
