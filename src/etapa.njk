---
pagination:
  data: trasa.etapy
  size: 1
  alias: e
permalink: "{{ e.adresa }}index.html"
layout: zaklad.njk
eleventyComputed:
  titulek: "Etapa {{ e.cislo }}: {{ e.nazev }}"
  metaPopis: "Etapa {{ e.cislo }} závodu Hory Bory: {{ e.nazev }}, {{ e.delkaKm }} km, převýšení {{ e.prevyseni }} m."
  adresa: "/trasa/"
---
<meta name="hb-rok" content="{{ trasa.rokCislo }}">


<nav class="etapa-drobky" aria-label="Kde jste">
  <a href="{{ web.zaklad }}/trasa/">Trasa a etapy</a> <span aria-hidden="true">›</span> Etapa {{ e.cislo }}
</nav>

<h1 class="etapa-nadpis"><span class="etapa-cislo">{{ e.cislo }}</span> {{ e.nazev }}</h1>

<ul class="etapa-cisla">
  <li><strong>{{ e.delkaKm }} km</strong><span>délka</span></li>
  <li><strong>{{ e.prevyseni }} m</strong><span>stoupání</span></li>
  <li><strong>{{ e.klesani }} m</strong><span>klesání</span></li>
  {% if e.penalizace %}<li><strong>{{ e.penalizace }}</strong><span>penalizace</span></li>{% endif %}
</ul>

{% if e.povrch %}<p class="etapa-povrch">Povrch: {{ e.povrch }}</p>{% endif %}

<section class="etapa-blok">
  <h2>Výškový profil</h2>
  <figure class="profil">
    <svg viewBox="0 0 {{ e.svg.S }} {{ e.svg.V }}" preserveAspectRatio="none" role="img"
         aria-label="Výškový profil etapy {{ e.cislo }}: začíná v {{ e.profil.min }} m n. m., nejvýše {{ e.profil.max }} m n. m.">
      <path class="profil-plocha" d="{{ e.svg.plocha }}"></path>
      <path class="profil-cara" d="{{ e.svg.cara }}"></path>
    </svg>
    <div class="profil-osa">
      {% for o in e.svg.osa %}
      <span class="kotva-{{ o.kotva }}" style="left: {{ (o.x / e.svg.S * 100) | round(2) }}%">{{ o.km }}{% if o.jednotka %}&nbsp;km{% endif %}</span>
      {% endfor %}
    </div>
    <figcaption>
      <span>{{ e.start.kod }} {{ e.start.nazev }} · {{ e.profil.startV }} m n. m.</span>
      <span class="profil-vrchol">nejvýše {{ e.profil.max }} m n. m.</span>
      <span>{{ e.cil.kod }} {{ e.cil.nazev }} · {{ e.profil.cilV }} m n. m.</span>
    </figcaption>
  </figure>
</section>

<section class="etapa-blok etapa-body">
  <div class="etapa-bod">
    <h2>Start</h2>
    <p class="etapa-misto"><span class="etapa-kod">{{ e.start.kod }}</span> {{ e.start.nazev }}</p>
    {% if e.start.detail %}<p class="etapa-gps">{{ e.start.detail }}</p>{% endif %}
  </div>
  <div class="etapa-bod">
    <h2>Cíl</h2>
    <p class="etapa-misto"><span class="etapa-kod">{{ e.cil.kod }}</span> {{ e.cil.nazev }}</p>
    {% if e.cil.detail %}<p class="etapa-gps">{{ e.cil.detail }}</p>{% endif %}
  </div>
</section>


{% if e.popis %}
<section class="etapa-blok">
  <h2>Trasa běžce</h2>
  <div class="text etapa-popis">{{ e.popis | safe }}</div>
</section>
{% endif %}


<section class="etapa-blok etapa-mapa">
  <h2>Mapa trasy</h2>
  <img src="{{ web.zaklad }}{{ e.obrazky.mapa }}" alt="Mapa trasy etapy {{ e.cislo }}" loading="lazy" width="900" height="1100">
  {% if e.mapaUrl %}
  <div class="etapa-qr">
    <a href="{{ e.mapaUrl }}" rel="noopener"><img src="{{ web.zaklad }}{{ e.obrazky.qr }}" alt="QR kód na trasu etapy {{ e.cislo }} v mapách" width="120" height="120"></a>
    <p>Trasa v mapě<br><a href="{{ e.mapaUrl }}" rel="noopener">otevřít na mapy.com</a></p>
  </div>
  {% endif %}
</section>

<section class="etapa-blok etapa-parkovani">
  <h2>Parkování v cíli</h2>
  <img src="{{ web.zaklad }}{{ e.obrazky.parkoviste }}" alt="Letecký snímek parkoviště u cíle etapy {{ e.cislo }}" loading="lazy" width="700" height="450">
  {% if e.autoKm %}
  <p class="etapa-auto">Autem z předchozí předávky {{ e.autoKm }} km, přibližně {{ e.autoMin }} minut.</p>
  {% endif %}
</section>

{% if e.useky.length %}
<section class="etapa-blok etapa-useky-blok">
  <h2>Úseky etapy</h2>
  <div class="table-responsive">
  <table class="etapa-useky">
    <thead>
      <tr><th>Od&nbsp;km</th><th>Do&nbsp;km</th><th>Délka</th><th>Ráz</th><th>Povrch</th><th>Sklon</th><th>Auto</th></tr>
    </thead>
    <tbody>
      {% for u in e.useky %}
      <tr>
        <td>{{ (u.od_m / 1000) | round(1) }}</td>
        <td>{{ (u.do_m / 1000) | round(1) }}</td>
        <td>{% if u.delka_m < 1000 %}{{ u.delka_m }} m{% else %}{{ (u.delka_m / 1000) | round(1) }} km{% endif %}</td>
        <td>{{ u.raz }}</td>
        <td>{{ u.povrch }}</td>
        <td>{{ u.sklon_pct }} %</td>
        <td>{% if u.auto %}ano{% else %}ne{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="etapa-vysvetlivka">Sloupec „Auto“ říká, jestli se dá úsek objet autem — doprovod podle něj pozná, kde běžce uvidí.</p>
</section>
{% endif %}

<nav class="etapa-sousedi" aria-label="Další etapy">
  {% if e.predchozi %}<a class="etapa-zpet" href="{{ web.zaklad }}{{ e.predchozi.adresa }}">‹ {{ e.predchozi.cislo }}. {{ e.predchozi.nazev }}</a>{% endif %}
  {% if e.dalsi %}<a class="etapa-vpred" href="{{ web.zaklad }}{{ e.dalsi.adresa }}">{{ e.dalsi.cislo }}. {{ e.dalsi.nazev }} ›</a>{% endif %}
</nav>

<p class="etapa-tisk">
  {% if e.pdf %}<a class="c-btn" href="{{ web.zaklad }}{{ e.pdf }}">Stáhnout kartu etapy (PDF)</a>{% endif %}
  {% if e.gpx %}<a class="c-btn c-btn-vedlejsi" href="{{ web.zaklad }}{{ e.gpx }}" download>Stáhnout GPX</a>{% endif %}
</p>
<p class="etapa-tisk-pozn">Kartu je nejlepší vytisknout ze staženého PDF — má hotovou tiskovou podobu na dvě strany A4.</p>

{#  Tištěná karta etapy. Na obrazovce se nezobrazuje, v tisku naopak nahrazuje
    celou stránku. Je to samostatná struktura — dva listy A4, každý s vlastní
    hlavičkou a patičkou — aby se nemusela ohýbat podoba webové stránky.  #}
<div class="karta" aria-hidden="true">
  {% set hlavicka %}
  <div class="karta-hlavicka">
    <img src="{{ web.zaklad }}/assets/etapy/karta-hlavicka.png" alt="">
    {#  Odznak etapy. Překrývá menší oranžové kolečko zapečené v hlavičce:
        po obvodu bílé slovo ETAPA, číslice vycentrovaná v horní polovině.  #}
    <svg class="karta-odznak" viewBox="0 0 100 100" role="img" aria-label="Etapa {{ e.cislo }}">
      <circle cx="50" cy="50" r="49" fill="#F7B211"/>
      <path id="oblouk-{{ e.cislo }}" fill="none" d="M 12 50 a 38 38 0 0 0 76 0"/>
      <text class="karta-odznak-cislo" x="50" y="48" text-anchor="middle">{{ e.cislo }}</text>
      <text class="karta-odznak-slovo">
        <textPath href="#oblouk-{{ e.cislo }}" startOffset="50%" text-anchor="middle">ETAPA</textPath>
      </text>
    </svg>
  </div>
  {% endset %}
  {% set paticka %}<div class="karta-paticka"><span>Hory Bory – Závod {{ trasa.rokCislo }}</span></div>{% endset %}

  <section class="karta-list">
    {{ hlavicka | safe }}
    <div class="karta-telo">
      <dl class="karta-radky">
        <dt>Start</dt><dd><b>{{ e.start.kod }}</b> {{ e.start.plny }}</dd>
        <dt>Cíl</dt><dd><b>{{ e.cil.kod }}</b> {{ e.cil.plny }}</dd>
        <dt>Trasa běžce</dt><dd class="karta-popis">{{ e.popis }}</dd>
        <dt>Délka, povrch,<br>stoupání, klesání</dt>
        <dd>{{ e.delkaKm }} km, {{ e.povrch }},<br>stoupání {{ e.prevyseni }} m, klesání {{ e.klesani }} m</dd>
      </dl>

      <div class="karta-pas">
        <div class="karta-profil">
          <svg viewBox="0 0 {{ e.svg.S }} {{ e.svg.V }}" preserveAspectRatio="none">
            <path class="profil-plocha" d="{{ e.svg.plocha }}"></path>
            <path class="profil-cara" d="{{ e.svg.cara }}"></path>
          </svg>
          <div class="karta-vysky">
            {% for b in e.svg.popisky %}
            <span class="kotva-{{ b.kotva }}" style="left: {{ (b.x / e.svg.S * 100) | round(2) }}%">
              <strong>{{ b.v }}</strong><em>m n. m.</em>
            </span>
            {% endfor %}
          </div>
          <div class="karta-osa">
            {% for o in e.svg.osa %}
            <span class="kotva-{{ o.kotva }}" style="left: {{ (o.x / e.svg.S * 100) | round(2) }}%">{{ o.km }}{% if o.jednotka %} km{% endif %}</span>
            {% endfor %}
          </div>
        </div>
        <div class="karta-qr">
          <p>Cíl etapy – trasa pro auto</p>
          <img src="{{ web.zaklad }}{{ e.obrazky.qr }}" alt="">
        </div>
      </div>

      <img class="karta-parkoviste" src="{{ web.zaklad }}{{ e.obrazky.parkoviste }}" alt="">
    </div>
    {{ paticka | safe }}
  </section>

  <section class="karta-list">
    {{ hlavicka | safe }}
    <div class="karta-telo">
      <img class="karta-mapa" src="{{ web.zaklad }}{{ e.obrazky.mapa }}" alt="">
    </div>
    {{ paticka | safe }}
  </section>
</div>
