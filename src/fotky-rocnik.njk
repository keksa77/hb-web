---
pagination:
  data: obsah.galerie
  size: 1
  alias: g
permalink: "/fotky/{{ g.letopocet }}/index.html"
layout: zaklad.njk
eleventyComputed:
  titulek: "Fotky Hory Bory {{ g.letopocet }}"
  metaPopis: "Fotky ze štafetového běhu Hory Bory {{ g.letopocet }} – start, trasa a cíl."
  adresa: "/fotky/{{ g.letopocet }}/"
---
{# Galerie jednoho ročníku z tabulky fotky (funkce web_galerie). Záložky Start/Trasa/Cíl se ukážou jen tam, kde jsou fotky zařazené. Keksa 12. 10. 2026. #}
<p class="drobecky"><a href="{{ web.zaklad }}/fotky/">Fotky ze závodu</a> › {{ g.letopocet }}</p>
<h1>Fotky Hory Bory {{ g.letopocet }}</h1>
{% if g.sekce.length %}
<div class="gal-zalozky" role="tablist">
  <button type="button" class="gal-zalozka gal-aktivni" data-sekce="">Vše <span>{{ g.pocet }}</span></button>
  {% set nazvy = { "start": "Start", "trasa": "Trasa", "cil": "Cíl" } %}
  {% for k in g.sekce %}<button type="button" class="gal-zalozka" data-sekce="{{ k }}">{{ nazvy[k] }}</button>{% endfor %}
</div>
{% endif %}
<div class="gal-mrizka" id="gal-mrizka">
{% for f in g.fotky %}<a href="{{ f.u }}" data-s="{{ f.s }}"{% if f.a %} data-a="{{ f.a }}"{% endif %}><img src="{{ f.u }}" alt="Hory Bory {{ g.letopocet }}, fotka {{ loop.index }}" loading="lazy" width="768" height="512"></a>{% endfor %}
</div>
<p class="gal-dalsi">Další ročníky: {% for x in obsah.galerie %}{% if x.rok != g.rok %}<a href="{{ web.zaklad }}{{ x.adresa }}">{{ x.letopocet }}</a>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</p>
<script src="{{ web.zaklad }}/assets/galerie.js" defer></script>
